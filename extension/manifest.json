{
  "manifest_version": 3,
  "name": "Dva lístky do Dejvic",
  "version": "0.2.0",
  "description": "Osobní asistent pro výběr dvou lístků do Dejvického divadla. Platbu dokončuješ ručně.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "debugger",
    "power",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.dejvickedivadlo.cz/*",
    "https://www.ticketportal.cz/*",
    "https://ticketportal.cz/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Otevřít Dva lístky do Dejvic"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
